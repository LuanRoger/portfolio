---
import CodingStatsAccordion from "./react/charts/coding-stats-accordion";
import Link from "@/components/Link.astro";
import Icon from "@/components/Icon.astro";
import { actions } from "astro:actions";
import { secondsToHours } from "@/lib/utils/time";
import { getCollection } from "astro:content";

const [
    wakatimeStatsData,
    wakatimeAllTimeData,
    githubProfileData,
    githubRepositoriesData,
] = await Promise.all([
    Astro.callAction(actions.wakatime.getWakatimeStats.orThrow, {}),
    Astro.callAction(actions.wakatime.getWakatimeAllTimeMetrics.orThrow, {}),
    Astro.callAction(actions.github.getGithubProfile.orThrow, {}),
    Astro.callAction(actions.github.getGithubProfileRepositories.orThrow, {}),
]);
const githubLanguageColors = await getCollection("githubLanguageColors");

const languagesData = githubRepositoriesData.map((repo) => {
    const { languages } = repo;
    if (!languages || languages.length === 0) {
        return null;
    }

    return languages;
});

const filteredLanguages = languagesData.filter((lang) => lang !== null).flat();
const languages = filteredLanguages.reduce(
    (acc, lang) => {
        if (acc[lang.name]) {
            acc[lang.name].value += lang.size;
            return acc;
        }

        const color = githubLanguageColors.find((item) => item.id === lang.name)
            ?.data.color;
        acc[lang.name] = {
            label: lang.name,
            value: lang.size,
            color: color ?? "#808080",
        };
        return acc;
    },
    {} as {
        [key: string]: {
            label: string;
            value: number;
            color: string;
        };
    },
);

const githubLanguagesChartData = Object.values(languages);

const stargazersCount = githubRepositoriesData.reduce(
    (acc, repo) => acc + repo.stargazersCount,
    0,
);

const { languages: wakatimeLanguages, avarengeText } = wakatimeStatsData;
const langaugeChart = wakatimeLanguages.map((language) => ({
    name: language.name,
    value: secondsToHours(language.totalSeconds),
    fill: language.metadata?.color,
}));
const { text: allTimeText } = wakatimeAllTimeData;
---

<CodingStatsAccordion
    client:visible
    wakatimeLanguageChart={{ data: langaugeChart }}
    wakatimeAverageText={avarengeText}
    wakatimeAllTimeText={allTimeText}
    githubProfileData={githubProfileData}
    stargazersCount={stargazersCount}
    githubLanguagesData={githubLanguagesChartData}
>
    <div slot="wakatimeFooter" class="self-end text-muted-foreground">
        <Link
            class="inline-flex items-center gap-2 self-end font-medium"
            href={"https://wakatime.com"}
            isExternal
        >
            Powered by{" "}
            <Icon
                name="wakatime"
                class="inline-block size-4 fill-muted-foreground"
            />
        </Link>
    </div>
    <div slot="githubIcon" class="contents">
        <Icon name="github" class="size-4 fill-white" />
    </div>
    <div slot="githubFooter" class="text-muted-foreground self-end">
        <Link
            class="inline-flex items-center gap-2 self-end font-medium"
            href={"https://docs.github.com/en/rest"}
            isExternal
        >
            Powered by{" "}
            <Icon
                name="github"
                class="inline-block size-4 fill-muted-foreground"
            />
        </Link>
    </div>
</CodingStatsAccordion>
