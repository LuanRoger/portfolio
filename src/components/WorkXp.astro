---
import type { SvgComponent } from "astro/types";
import { DateTime } from "luxon";

interface Props {
  company: string;
  companyDescription?: string;
  possitions: {
    title: string;
    type: string;
    startDate: DateTime;
    endDate: DateTime | "now";
    responsabilities: string[];
  }[];
}

const { company, companyDescription, possitions } = Astro.props;
---

<li class="flex flex-col gap-2">
  <div class="flex flex-col gap-2">
    <div class="flex items-center gap-2">
      <div class="border-border bg-card rounded-md border p-1">
        <slot name="companyLogo" />
      </div>
      <h3 class="text-lg font-bold">{company}</h3>
    </div>
    {companyDescription && <p class="text-sm">{companyDescription}</p>}
  </div>
  <ul class="ml-2">
    {possitions.map(({ title, responsabilities, startDate, endDate, type }) => {
      const formattedStartDate = startDate.toLocaleString(DateTime.DATE_MED, {
        locale: "en-US",
      });
      const formattedEndDate =
        endDate === "now"
          ? "Present"
          : endDate.toLocaleString(DateTime.DATE_MED, {
              locale: "en-US",
            });

      return (
        <li>
          <h4 class="text-md font-bold">{title}</h4>
          <p class="text-muted-foreground text-sm">
            {type} | {formattedStartDate} - {formattedEndDate}
          </p>
          <div class="prose prose-invert prose-portfolio">
            <ul>
              {responsabilities.map((responsibility) => (
                <li>{responsibility}</li>
              ))}
            </ul>
          </div>
        </li>
      );
    })}
  </ul>
</li>
