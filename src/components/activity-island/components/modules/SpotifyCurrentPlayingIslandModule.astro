---
import type { SpotifyCurrentPlayingTrackInfo } from "@/types/spotify";
import Base from "./Base.astro";
import { formatSpotifyArtistsName } from "@/lib/utils/formatters";
import SpotifyIcon from "@/assets/icons/spotify.svg";

interface Props {
    title?: string | undefined;
    spotifyInfo: SpotifyCurrentPlayingTrackInfo;
}

const { title, spotifyInfo } = Astro.props;

const { name, artists, href, image } = spotifyInfo;
const formatedArtists = formatSpotifyArtistsName(artists);
---

<Base
    accentColor="#1ED760"
    activityDescription={title ?? "Listening to"}
    description={formatedArtists}
    href={href}
    imageAlt={`${name} album cover`}
    imageSrc={image.url}
    title={name}
>
    <SpotifyIcon class="size-4 fill-foreground" slot="icon" />
</Base>
