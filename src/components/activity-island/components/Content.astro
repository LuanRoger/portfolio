---
import { cn } from "@/lib/cn";
import type { Presence } from "@/types/presence";
import type {
  LastPlayedGame,
  RetroachievementsUserProfile,
} from "@/types/retroachievements";
import type { SpotifyCurrentPlayingTrackInfo } from "@/types/spotify";
import Header from "./Header.astro";
import RetroachievementsActivityIslandModule from "./modules/RetroachievementsActivityIslandModule.astro";
import SpotifyCurrentPlayingIslandModule from "./modules/SpotifyCurrentPlayingIslandModule.astro";

interface Props {
  className?: string;
  retroachievementsActivityInfo?: {
    userProfileInfo: RetroachievementsUserProfile;
    lastGamePlayedInfo: LastPlayedGame;
  };
  spotifyPlayingInfo?: SpotifyCurrentPlayingTrackInfo;
  status: Presence;
}

const { status, spotifyPlayingInfo, retroachievementsActivityInfo, className } =
  Astro.props;
---

<div
  class={cn(
        "flex flex-col items-center opacity-0",
        className,
    )}
  id="activity-island"
>
  <Header status={status} />
  <div class="overflow-hidden rounded-b-md size-full">
    {spotifyPlayingInfo && (
                <SpotifyCurrentPlayingIslandModule
                    spotifyInfo={spotifyPlayingInfo}
                />
            )}
    {retroachievementsActivityInfo && (
                <RetroachievementsActivityIslandModule
                    lastGamePlayedInfo={
                        retroachievementsActivityInfo.lastGamePlayedInfo
                    }
                    userProfile={retroachievementsActivityInfo.userProfileInfo}
                />
            )}
  </div>
</div>

<script>
  import { animate } from "motion/mini";

  const element = document.getElementById("activity-island");
  if (element) {
    animate(
      element,
      { opacity: [0, 1], transform: ["scale(0.95)", "scale(1)"] },
      { duration: 0.4, type: "spring" }
    );
  }
</script>
