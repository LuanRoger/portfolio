---
import Dot from "@/components/Dot.astro";
import { cn } from "@/lib/cn";
import type { Presence } from "@/types/presence";

interface Props {
  status: Presence;
}

const { status } = Astro.props;
---

<div
  class={cn(
    "flex w-full items-center justify-center gap-1 rounded-t-md px-2 py-1 text-sm font-semibold text-white inset-shadow-xs",
    {
      "bg-green-700 inset-shadow-green-700": status === "online",
      "rounded-b-md bg-gray-700 inset-shadow-gray-700": status === "offline",
    }
  )}
>
  <Dot
    animate={status === "online"}
    dotClassName={status === "online" ? "bg-green-400" : "bg-gray-400"}
  />
  {status.toString()}
</div>
