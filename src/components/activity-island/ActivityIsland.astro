---
import { hoursSince } from "@/lib/utils/time";
import Content from "./components/Content.astro";
import { getSpotifyCurrentPlaying } from "@/services/spotify";
import { getRetroachievementsLastGamePlayed, getRetroachievementsUserProfile } from "@/services/retroachievements";

interface Props {
  className?: string;
}

const { className } = Astro.props as Props;

const [currentPlayingInfo, retroachievementsUserProfile, lastGamePlayedInfo] =
  await Promise.all([
    getSpotifyCurrentPlaying(),
    getRetroachievementsUserProfile(),
    getRetroachievementsLastGamePlayed(),
  ]);

const { isPlaying: isSpotifyPlaying } = currentPlayingInfo;
const { lastPlayed } = lastGamePlayedInfo;
const parsedLastPlayed = new Date(lastPlayed);
const hoursSinceLastRetroachievementsPlay = hoursSince(parsedLastPlayed);
const isRetroachievementsActive = hoursSinceLastRetroachievementsPlay < 1;

const isOnline = isSpotifyPlaying || isRetroachievementsActive;
---

<Content
  className={className}
  retroachievementsActivityInfo={isRetroachievementsActive
    ? {
        lastGamePlayedInfo,
        userProfileInfo: retroachievementsUserProfile,
      }
    : undefined}
  spotifyPlayingInfo={isSpotifyPlaying ? currentPlayingInfo : undefined}
  status={isOnline ? "online" : "offline"}
/>
