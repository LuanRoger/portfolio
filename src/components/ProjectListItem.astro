---
import type { Project } from "@/types/project";
import { ENV } from "varlock/env";
import { Button } from "./react/ui/button";
import Link from "@/components/Link.astro";
import Icon from "@/components/Icon.astro";
import { Image } from "astro:assets";
import MinimalTechBadge from "@/components/MinimalTechBadge.astro";
import {
    Card,
    CardDescription,
    CardFooter,
    CardHeader,
    CardTitle,
} from "./react/ui/card";

interface Props {
    project: Project;
    className?: string;
}

const { project, className } = Astro.props;
const { title, image, description, link, repoName, techStack } = project;
const { src: imageSrc, alt: imageAlt } = image;
const githubUrl = ENV.GITHUB_URL;
const githubUsername = ENV.GITHUB_USERNAME;

const repoLink =
    repoName && githubUrl && githubUsername
        ? `${githubUrl}/${githubUsername}/${repoName}`
        : undefined;
---

<div
    class:list={[
        "flex h-96 overflow-clip rounded-md flex-col border border-border",
        className,
    ]}
>
    <div class="relative flex-1">
        <div
            class="absolute top-0 z-30 flex w-full flex-row flex-wrap gap-2 p-2"
        >
            {techStack.map((tech) => <MinimalTechBadge tech={tech} />)}
        </div>
        <Image
            alt={imageAlt}
            class="absolute inset-0 z-10 size-full object-cover mask-t-from-75%"
            src={imageSrc}
        />
    </div>
    <Card size="sm" className="rounded-t-none rounded-b-md flex-none">
        <CardHeader>
            <CardTitle>{title}</CardTitle>
            <CardDescription>{description}</CardDescription>
        </CardHeader>
        <CardFooter className="flex gap-2">
            {
                repoLink && (
                    <Link
                        aria-label={`GitHub repository for ${repoName}`}
                        href={repoLink}
                        target="_blank"
                    >
                        <Button
                            size="icon"
                            variant="secondary"
                            aria-label={`GitHub repository for ${repoName}`}
                        >
                            <Icon name="github" class="fill-foreground" />
                        </Button>
                    </Link>
                )
            }
            {
                link && (
                    <Link
                        aria-label={`Project link to ${title}`}
                        href={link}
                        target="_blank"
                    >
                        <Button
                            size="icon"
                            variant="secondary"
                            aria-label={`Project link to ${title}`}
                        >
                            <Icon
                                name="external-link"
                                class="stroke-foreground fill-transparent"
                            />
                        </Button>
                    </Link>
                )
            }
        </CardFooter>
    </Card>
</div>
