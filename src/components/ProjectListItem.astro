---
import { Image } from "astro:assets";
import { ENV } from "varlock/env";
import Icon from "@/components/Icon.astro";
import Link from "@/components/Link.astro";
import MinimalTechBadge from "@/components/MinimalTechBadge.astro";
import type { Project } from "@/types/project";
import { Button } from "./react/ui/button";
import {
  Card,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "./react/ui/card";

interface Props {
  className?: string;
  project: Project;
}

const { project, className } = Astro.props;
const { title, image, description, link, repoName, techStack } = project;
const { src: imageSrc, alt: imageAlt } = image;
const githubUrl = ENV.GITHUB_URL;
const githubUsername = ENV.GITHUB_USERNAME;

const repoLink =
  repoName && githubUrl && githubUsername
    ? `${githubUrl}/${githubUsername}/${repoName}`
    : undefined;
---

<div
  class:list={[
    "border-border flex h-96 flex-col overflow-clip rounded-md border",
    className,
  ]}
>
  <div class="relative flex-1">
    <div class="absolute top-0 z-30 flex w-full flex-row flex-wrap gap-2 p-2">
      {techStack.map((tech) => <MinimalTechBadge tech={tech} />)}
    </div>
    <Image
      alt={imageAlt}
      class="absolute inset-0 z-10 size-full mask-t-from-75% object-cover"
      height={300}
      src={imageSrc}
      width={500}
    />
  </div>
  <Card className="flex-none rounded-t-none rounded-b-md" size="sm">
    <CardHeader>
      <CardTitle>{title}</CardTitle>
      <CardDescription>{description}</CardDescription>
    </CardHeader>
    <CardFooter className="flex gap-2">
      {repoLink && (
        <Link
          aria-label={`GitHub repository for ${repoName}`}
          href={repoLink}
          target="_blank"
        >
          <Button
            aria-label={`GitHub repository for ${repoName}`}
            size="icon"
            variant="secondary"
          >
            <Icon class="fill-foreground" name="github" />
          </Button>
        </Link>
      )}
      {link && (
        <Link
          aria-label={`Project link to ${title}`}
          href={link}
          target="_blank"
        >
          <Button
            aria-label={`Project link to ${title}`}
            size="icon"
            variant="secondary"
          >
            <Icon
              class="stroke-foreground fill-transparent"
              name="external-link"
            />
          </Button>
        </Link>
      )}
    </CardFooter>
  </Card>
</div>
