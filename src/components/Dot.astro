---
interface Props {
  animate?: boolean;
  animationClass?: string;
  className?: string;
  dotClassName?: string;
  style?: React.CSSProperties | undefined;
}

const { className, animate, animationClass, dotClassName, style } = Astro.props;
---

<span class:list={["relative inset-shadow-xs flex size-2", className]}>
  {animate && (
            <span
                class:list={[
                    "absolute inline-flex h-full w-full animate-ping-slow rounded-full bg-green-400 opacity-75",
                    animationClass,
                ]}
            />
        )}
  <span
    style={style}
    class:list={["h-full w-full rounded-full shadow-xs", dotClassName]}
  ></span>
</span>
