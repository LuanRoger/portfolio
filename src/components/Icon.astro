    "digital-ocean": (await import("@/assets/icons/digital-ocean.svg")).default,
    docker: (await import("@/assets/icons/docker.svg")).default,
    dotnet: (await import("@/assets/icons/dotnet.svg")).default,
    electron: (await import("@/assets/icons/electron.svg")).default,
    "external-link": (await import("@/assets/icons/external-link.svg")).default,
    firebase: (await import("@/assets/icons/firebase.svg")).default,
    flutter: (await import("@/assets/icons/flutter.svg")).default,
    git: (await import("@/assets/icons/git.svg")).default,
    github: (await import("@/assets/icons/github.svg")).default,
    grafana: (await import("@/assets/icons/grafana.svg")).default,
    "mais-informa": (await import("@/assets/icons/mais-informa.svg")).default,
    minio: (await import("@/assets/icons/minio.svg")).default,
    mongodb: (await import("@/assets/icons/mongodb.svg")).default,
    mysql: (await import("@/assets/icons/mysql.svg")).default,
    nextjs: (await import("@/assets/icons/nextjs.svg")).default,
    node: (await import("@/assets/icons/node.svg")).default,
    postgresql: (await import("@/assets/icons/postgresql.svg")).default,
    prometheus: (await import("@/assets/icons/prometheus.svg")).default,
    python: (await import("@/assets/icons/python.svg")).default,
