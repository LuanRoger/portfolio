---
import ActivitiesIslandLoading from "@/components/activity-island/ActivitiesIslandLoading.astro";
import ActivitiesIsland from "@/components/activity-island/ActivityIsland.astro";
import NameHeader from "@/components/NameHeader.astro";
import TechStack from "@/components/TechStack.astro";
---

<section class="flex flex-col gap-4">
  <NameHeader />
  <div class="flex flex-col-reverse justify-between gap-2 lg:flex-row">
    <TechStack />
    <ActivitiesIsland className="w-full self-start lg:w-56" server:defer>
      <ActivitiesIslandLoading slot="fallback" />
    </ActivitiesIsland>
  </div>
</section>
