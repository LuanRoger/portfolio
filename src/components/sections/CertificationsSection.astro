  <CertificationsBadge />
  <ul class="list-disc space-y-4 pl-5">
    <li>
      <Link
        href="https://www.freecodecamp.org/certification/fcc3ae4e227-f746-4cb0-a5bc-eaffae04386b/foundational-c-sharp-with-microsoft"
        isExternal
      >
        Foundational C# with Microsoft (FreeCodeCamp)
      </Link>
    </li>
  </ul>
</section>
