---
import "@/styles/global.css";
import { Font } from "astro:assets";
import Background from "@/components/Background.astro";

const title = "Luan Roger | Full-Stack Developer";
const description =
  "Portfolio of Luan Roger, a full-stack software engineer in Brazil building scalable web platforms, APIs, microservices, and open-source project and tools.";
const canonicalURL = "https://luanroger.dev";
const socialImageURL = new URL(
  "/web-app-manifest-512x512.png",
  Astro.site ?? Astro.url.origin
);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@id": `${canonicalURL}#website`,
      "@type": "WebSite",
      author: { "@id": `${canonicalURL}#about` },
      description,
      inLanguage: "en",
      name: "Luan Roger",
      url: canonicalURL,
    },
    {
      "@id": `${canonicalURL}#about`,
      "@type": "Person",
      description,
      familyName: "Roger",
      givenName: "Luan",
      image: socialImageURL.href,
      jobTitle: "Full-Stack Software Engineer",
      knowsAbout: [
        "TypeScript",
        "React",
        "Next.js",
        "Astro",
        "Node.js",
        "Rust",
        "MongoDB",
        "PostgreSQL",
        "Cloudflare",
        "Docker",
        "OpenTelemetry",
        "Microservices",
      ],
      name: "Luan Roger",
      nationality: {
        "@type": "Country",
        name: "Brazil",
      },
      sameAs: [
        "https://github.com/LuanRoger",
        "https://linkedin.com/in/luan-roger",
        "https://blog.luanroger.dev",
      ],
      url: canonicalURL,
      worksFor: {
        "@type": "Organization",
        name: "Aramis",
        url: "https://www.aramis.com.br",
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <title>{title}</title>
    <meta content={description} name="description">
    <meta content="Luan Roger" name="author">
    <meta
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      name="robots"
    >
    <meta content="strict-origin-when-cross-origin" name="referrer">
    <meta content="#09090b" name="theme-color">
    <meta content="dark" name="color-scheme">
    <link href={canonicalURL} rel="canonical">

    <meta content="profile" property="og:type">
    <meta content="Luan Roger" property="og:site_name">
    <meta content={title} property="og:title">
    <meta content={description} property="og:description">
    <meta content={canonicalURL} property="og:url">
    <meta content={socialImageURL} property="og:image">
    <meta content="512" property="og:image:width">
    <meta content="512" property="og:image:height">
    <meta
      content="Luan Roger full-stack software engineer portfolio"
      property="og:image:alt"
    >
    <meta content="en_US" property="og:locale">
    <meta content="Luan" property="profile:first_name">
    <meta content="Roger" property="profile:last_name">

    <meta content="summary" name="twitter:card">
    <meta content={title} name="twitter:title">
    <meta content={description} name="twitter:description">
    <meta content={socialImageURL} name="twitter:image">
    <meta
      content="Luan Roger full-stack software engineer portfolio"
      name="twitter:image:alt"
    >

    <link href="/favicon-96x96.png" rel="icon" sizes="96x96" type="image/png">
    <link href="/favicon.svg" rel="icon" type="image/svg+xml">
    <link href="/favicon.ico" rel="shortcut icon">
    <link href="/apple-touch-icon.png" rel="apple-touch-icon" sizes="180x180">
    <link href="/site.webmanifest" rel="manifest">
    <link href="/sitemap-index.xml" rel="sitemap" type="application/xml">
    <meta content={Astro.generator} name="generator">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <Font cssVariable="--font-pixelta" />
  </head>
  <body class="dark">
    <div class="relative">
      <main
        class="z-10 w-full py-0 md:flex md:flex-row md:items-center md:justify-center md:py-4"
      >
        <slot />
      </main>
      <Background />
    </div>
  </body>
</html>
