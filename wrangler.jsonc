{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "portfolio",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 100,
    "subrequests": 10000
  }
}
