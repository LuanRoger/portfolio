---
import "@/styles/global.css";
import Background from "@/components/Background.astro";
import { Font } from "astro:assets";

const title = "Luan Roger | Full-Stack Software Engineer";
const description =
    "Portfolio of Luan Roger, a full-stack software engineer in Brazil building scalable web platforms, APIs, microservices, and open-source tools.";
const canonicalURL = "https://luanroger.dev";
const socialImageURL = new URL(
    "/web-app-manifest-512x512.png",
    Astro.site ?? Astro.url.origin,
);

const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebSite",
            "@id": `${canonicalURL}#website`,
            url: canonicalURL,
            name: "Luan Roger",
            description,
            inLanguage: "en",
            author: { "@id": `${canonicalURL}#about` },
        },
        {
            "@type": "Person",
            "@id": `${canonicalURL}#about`,
            name: "Luan Roger",
            givenName: "Luan",
            familyName: "Roger",
            url: canonicalURL,
            image: socialImageURL.href,
            jobTitle: "Full-Stack Software Engineer",
            description,
            nationality: {
                "@type": "Country",
                name: "Brazil",
            },
            worksFor: {
                "@type": "Organization",
                name: "Aramis",
                url: "https://www.aramis.com.br",
            },
            sameAs: [
                "https://github.com/LuanRoger",
                "https://linkedin.com/in/luan-roger",
                "https://blog.luanroger.dev",
            ],
            knowsAbout: [
                "TypeScript",
                "React",
                "Next.js",
                "Astro",
                "Node.js",
                "Rust",
                "MongoDB",
                "PostgreSQL",
                "Cloudflare",
                "Docker",
                "OpenTelemetry",
                "Microservices",
            ],
        },
    ],
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="author" content="Luan Roger" />
        <meta
            name="robots"
            content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
        <meta name="referrer" content="strict-origin-when-cross-origin" />
        <meta name="theme-color" content="#09090b" />
        <meta name="color-scheme" content="dark" />
        <link rel="canonical" href={canonicalURL} />

        <meta property="og:type" content="profile" />
        <meta property="og:site_name" content="Luan Roger" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={socialImageURL} />
        <meta property="og:image:width" content="512" />
        <meta property="og:image:height" content="512" />
        <meta
            property="og:image:alt"
            content="Luan Roger full-stack software engineer portfolio"
        />
        <meta property="og:locale" content="en_US" />
        <meta property="profile:first_name" content="Luan" />
        <meta property="profile:last_name" content="Roger" />

        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImageURL} />
        <meta
            name="twitter:image:alt"
            content="Luan Roger full-stack software engineer portfolio"
        />

        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png"
        />
        <link rel="manifest" href="/site.webmanifest" />
        <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
        <meta name="generator" content={Astro.generator} />
        <script
            type="application/ld+json"
            set:html={JSON.stringify(structuredData)}
        />
        <Font cssVariable="--font-pixelta" />
    </head>
    <body class="dark">
        <div class="relative">
            <main
                class="z-10 w-full py-0 md:flex md:flex-row md:items-center md:justify-center md:py-4"
            >
                <slot />
            </main>
            <Background />
        </div>
    </body>
</html>
