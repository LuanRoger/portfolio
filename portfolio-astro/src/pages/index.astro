---
import Layout from "../layouts/Layout.astro";
import HeroSection from "@/components/sections/HeroSection.astro";
import Separator from "@/components/Separator.astro";
import NavigationHeader from "@/components/NavigationHeader.astro";
import AboutSection from "@/components/sections/AboutSection.astro";
import ProjectsSection from "@/components/sections/ProjectsSection.astro";
import ExpirienceSection from "@/components/sections/ExpirienceSection.astro";
import CertificationsSection from "@/components/sections/CertificationsSection.astro";
import ContactSection from "@/components/sections/ContactSection.astro";
---

<Layout>
    <div
        class="relative z-20 bg-background/50 overflow-clip border-border md:w-3/5 md:rounded-md md:border"
    >
        <div class="space-y-3 p-4">
            <HeroSection />
            <Separator />
            <NavigationHeader />
            <!-- <AboutSection /> -->
            <ProjectsSection />
            <ExpirienceSection />
            <CertificationsSection />
            <ContactSection />
            <!--<FooterSection /> -->
        </div>
    </div>
</Layout>
