---
import WorkXp from "@/components/WorkXp.astro";
import Icon from "@/components/Icon.astro";
import LearningLabLogo from "@/assets/images/learning-lab-logo.png";
import { DateTime } from "luxon";
import { Image } from "astro:assets";
---

<section class="flex flex-col gap-2" id="expirience">
    <h2 class="font-bold text-xl">Expirience</h2>
    <ul>
        <WorkXp
            company="Aramis"
            companyDescription="Aramis is a menswear brand that has been on the market for almost 30 years. I work as a full-stack developer, helping the brand achieve its goal of technological revolution, creating and maintaining large-scale distributed micro-services, as well as developing dynamic UIs that provide an intuitive and efficient user experience, connecting customers and partners to the brand in an innovative and personalized way."
            possitions={[
                {
                    title: "Full-Stack Developer",
                    endDate: "now",
                    startDate: DateTime.fromISO("2024-10-01"),
                    type: "Full-Time",
                    responsabilities: [
                        "Helped build micro-frontends to be part of the brand's digital ecosystem",
                        "Developed micro-service to handle heavy read request from MongoDB",
                        "Developed TypeScript package to provide observability and monitoring tools for services",
                        "Improved MongoDB queries performance by about 30% by optimizing indexes and aggregation pipelines",
                        "Implemented observability with Prometheus and Loki in back-end services and Next.js",
                        "Helped implement payment integrations with VTEX into the brand's e-commerce mobile platform",
                        "Developed a CMS to manages the brand's training content",
                        "Helped to develop microservices to power the seller's mobile platform",
                        "Developed end-to-end features in the brand's multi-brand platform",
                    ],
                },
            ]}
        >
            <Icon name="aramis-logo" slot="companyLogo" class="size-6" />
        </WorkXp>
        <WorkXp
            company="Mais Informa"
            companyDescription="I have the task of developing all the solutions for disseminating information, a news portal and a newsletter, with the lowest possible operating costs. To do this, I lead two squads that develop one solution each. Some of the tools we use to maintain the newsletter were developed in-house for the exclusive use of the project, to help the news team's process."
            possitions={[
                {
                    title: "Tech Lead",
                    type: "Internship",
                    endDate: DateTime.fromISO("2026-04-01"),
                    startDate: DateTime.fromISO("2024-01-01"),
                    responsabilities: [
                        
                    ],
                },
            ]}
        >
            <Icon name="mais-informa" slot="companyLogo" class="size-6" />
        </WorkXp>
        <WorkXp
            company="LearningLab"
            companyDescription="LearningLab offers a comprehensive experience to computer science students through hands-on courses, lectures given by professionals in the field, and activities in areas such as development, research, and outreach."
            possitions={[
                {
                    title: "Back-end developer",
                    type: "Volunteer",
                    endDate: DateTime.fromISO("2024-10-01"),
                    startDate: DateTime.fromISO("2023-08-01"),
                    responsabilities: [""],
                },
            ]}
        >
            <Image
                src={LearningLabLogo}
                alt="LearningLab logo"
                slot="companyLogo"
                class="size-6 object-scale-down"
            />
        </WorkXp>
    </ul>
    <p class="text-sm">
        💡 In addition to my professional work, I also maintain open-source
        projects and libraries, that together, have more than 200 stars in
        repositories and 8,000 downloads.
    </p>
</section>
