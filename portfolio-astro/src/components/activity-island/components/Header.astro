---
import { cn } from "@/lib/cn";
import type { Presence } from "@/types/presence";
import Dot from "@/components/Dot.astro";

interface Props {
    status: Presence;
}

const { status } = Astro.props;
---

<div
    class={cn(
        "inset-shadow-xs flex w-full items-center justify-center gap-1 rounded-t-md px-2 py-1 font-semibold text-sm text-white",
        {
            "inset-shadow-green-700 bg-green-700": status === "online",
            "inset-shadow-gray-700 rounded-b-md bg-gray-700":
                status === "offline",
        },
    )}
>
    <Dot
        animate={status === "online"}
        dotClassName={status === "online" ? "bg-green-400" : "bg-gray-400"}
    />
    {status.toString()}
</div>
